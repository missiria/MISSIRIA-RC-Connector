[Unit]
Description=MISSIRIA RC Connector — MCP server for Roundcube
Documentation=https://github.com/missiria/MISSIRIA-RC-Connector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rcmcp
Group=rcmcp
WorkingDirectory=/opt/missiria-rc-connector/app
EnvironmentFile=/etc/missiria-rc-connector/env
Environment=NODE_OPTIONS=--no-warnings=ExperimentalWarning
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/missiria-rc-connector /var/log/missiria-rc-connector
ReadOnlyPaths=/etc/missiria-rc-connector /opt/missiria-rc-connector
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
