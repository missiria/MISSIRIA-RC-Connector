NODE_ENV=production
PORT=8787
BIND=127.0.0.1
PUBLIC_URL=https://mcp.example.com
WEBMAIL_URL=https://webmail.example.com
DB_PATH=/var/lib/missiria-rc-connector/connector.sqlite
KEYS_DIR=/etc/missiria-rc-connector/keys
INTERNAL_KEY=change-me-64-hex
JWT_SECRET=change-me-96-hex
IMAP_HOST=127.0.0.1
IMAP_PORT=993
IMAP_TLS=true
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_STARTTLS=true
ATTACHMENT_MAX_BYTES=5242880
LOG_LEVEL=info
LOG_FILE=/var/log/missiria-rc-connector/server.log
